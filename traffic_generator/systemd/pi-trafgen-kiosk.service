[Unit]
# Optional: only for a Pi with the 7" touch LCD attached. The tablet app does
# not need this - it talks to :8080 over WiFi.
Description=pi-trafgen kiosk browser
After=pi-trafgen.service graphical.target
Wants=pi-trafgen.service

[Service]
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
# Wait for the API to answer before opening the browser.
ExecStartPre=/bin/sh -c 'until curl -sf http://localhost:8080/api/system >/dev/null; do sleep 1; done'
ExecStart=/usr/bin/chromium-browser \
  --kiosk --incognito --noerrdialogs --disable-infobars \
  --disable-session-crashed-bubble --check-for-update-interval=31536000 \
  --overscroll-history-navigation=0 \
  http://localhost:8080/
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
